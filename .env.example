# Local development only. Change the password before exposing any deployment.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jobpulse
DB_USER=jobpulse
DB_PASSWORD=jobpulse-local-only
DB_CONNECT_TIMEOUT=5
DB_SSLMODE=prefer
# Optional for AI workflows; leave blank for offline tests and job browsing.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-001

# Public sources; enable API sources only after configuring real employer boards below.
JOBPULSE_SOURCES=python.org
# JSON arrays. Company names are explicit operator metadata; omit when unknown.
JOBPULSE_GREENHOUSE_BOARDS=[]
JOBPULSE_LEVER_BOARDS=[]
JOBPULSE_ASHBY_BOARDS=[]
# Examples (replace the board slugs with permitted public boards):
# JOBPULSE_GREENHOUSE_BOARDS=[{"board":"employer-token","company":"Employer name"}]
# JOBPULSE_LEVER_BOARDS=[{"board":"employer-id","company":"Employer name","region":"global"}]
# JOBPULSE_ASHBY_BOARDS=[{"board":"employer-board","company":"Employer name"}]
JOBPULSE_HTTP_PACE_SECONDS=0.25
# Optional paid provider processing is disabled by default in Airflow.
JOBPULSE_ENABLE_AI=false
JOBPULSE_AI_BATCH_SIZE=25
JOBPULSE_AIRFLOW_SCHEDULE=0 * * * *
JOBPULSE_AIRFLOW_RETRIES=2
JOBPULSE_AIRFLOW_RETRY_DELAY_MINUTES=5
API_PORT=8000
FRONTEND_PORT=3000
